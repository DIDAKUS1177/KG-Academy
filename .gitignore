.env
.env.local
.env.production

# material fuente de los cursos (exports de Genially, 20+ MB cada uno).
# El contenido se sirve embebido por URL publica; estos exports son solo
# respaldo local y no deben versionarse.
# Con "/" al inicio: solo la carpeta de la raíz. Sin ella se excluían también
# src/app/admin/cursos/NuevoCurso.tsx y src/app/api/admin/cursos/.
/cursos/

# python (generadores de documentos)
__pycache__/
*.pyc

# sistema y logs
*.log
.DS_Store
Thumbs.db

.vercel
.env*
