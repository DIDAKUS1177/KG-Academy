# dependencias
node_modules/

# build
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# base de datos local (se regenera con: npm run setup)
prisma/*.db
prisma/*.db-journal

# variables de entorno (contienen secretos)
