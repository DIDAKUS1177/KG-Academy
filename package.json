{
  "name": "kg-academy",
  "version": "1.0.0",
  "private": true,
  "description": "KG Academy - Plataforma educativa LMS B2C/B2B de KG Gestion Integral S.A.S.",
  "author": "Diego Alejandro Hernandez Blanco",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:postgres": "node scripts/proveedor-bd.mjs postgresql",
    "db:sqlite": "node scripts/proveedor-bd.mjs sqlite",
    "db:seed:prod": "tsx prisma/seed-produccion.ts",
    "db:sql": "node scripts/generar-sql.mjs",
    "verificar": "tsx scripts/recorrido.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.23.1": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": false
  }
}
