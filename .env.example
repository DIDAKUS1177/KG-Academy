# ---------------------------------------------------------------
# KG ACADEMY - plantilla de variables de entorno
# Copiar este archivo como .env y ajustar los valores.
#     cp .env.example .env
# ---------------------------------------------------------------

# --- Base de datos ---
# Desarrollo local (SQLite, cero configuracion):
DATABASE_URL="file:./kg_academy.db"
# Produccion (PostgreSQL). Ademas hay que cambiar en prisma/schema.prisma
# el provider a "postgresql":
# DATABASE_URL="postgresql://usuario:clave@host:5432/kg_academy?schema=public"

# --- Seguridad ---
# Clave con la que se firman los JWT de sesion.
# EN PRODUCCION generar una cadena larga y aleatoria, por ejemplo con:
#     openssl rand -base64 48
AUTH_SECRET="cambiar-esta-clave-por-una-aleatoria-y-larga"

# --- URL publica ---
# Debe ser el dominio DEFINITIVO antes de emitir el primer certificado:
# los codigos QR de verificacion se generan con esta direccion.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Semilla de producción (npm run db:seed:prod) ---
# Solo se usan si la base no tiene todavía ningún superadministrador.
# La contraseña debe tener 12 caracteres o más y NO puede ser la de la demo.
# SEED_ADMIN_EMAIL="direccion@kggestionintegral.com"
# SEED_ADMIN_PASSWORD="una-clave-larga-y-unica"
# SEED_ADMIN_NOMBRE="Katerine Guañarita"

# --- Correo (recuperación de contraseña por código) ---
# Cualquier proveedor con SMTP. Sin estas variables, en desarrollo los correos
# se guardan en .correos-dev/ y en producción se ofrece la recuperación manual.
# Ejemplo con Gmail (contraseña de aplicación, requiere verificación en 2 pasos):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="cuenta@gmail.com"
# SMTP_PASS="contraseña-de-aplicación"
# CORREO_REMITENTE="KG Academy <cuenta@gmail.com>"

