# ---------------------------------------------------------------
# KG ACADEMY - plantilla de variables de entorno
# Copiar este archivo como .env y ajustar los valores.
#     cp .env.example .env
# ---------------------------------------------------------------

# --- Base de datos ---
# Desarrollo local (SQLite, cero configuracion):
DATABASE_URL="file:./kg_academy.db"
# Produccion (PostgreSQL). Ademas hay que cambiar en prisma/schema.prisma
# el provider a "postgresql":
# DATABASE_URL="postgresql://usuario:clave@host:5432/kg_academy?schema=public"

# --- Seguridad ---
# Clave con la que se firman los JWT de sesion.
# EN PRODUCCION generar una cadena larga y aleatoria, por ejemplo con:
#     openssl rand -base64 48
AUTH_SECRET="cambiar-esta-clave-por-una-aleatoria-y-larga"

# --- URL publica ---
# Debe ser el dominio DEFINITIVO antes de emitir el primer certificado:
# los codigos QR de verificacion se generan con esta direccion.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
